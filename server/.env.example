# ---------------------------------------------------------------------------
# Sillara platform — server environment
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100
APP_URL=http://localhost:5273        # POS app (pos/)
SITE_URL=http://localhost:5274       # marketing site
API_URL=http://localhost:4100

DATABASE_URL="mysql://root:@127.0.0.1:3306/sillara"

# openssl rand -hex 32  (two different values)
JWT_SECRET=replace_with_64_hex_chars
MAGIC_LINK_SECRET=replace_with_64_hex_chars
ACCESS_TOKEN_TTL=12h

CORS_ORIGINS=http://localhost:5273,http://localhost:5274

# --- Background jobs --------------------------------------------------------
# Billing lifecycle, daily digests, email outbox flush, cleanup.
# Safe to leave true on every instance: each job takes a database lock first.
RUN_JOBS=true

# --- Payments -------------------------------------------------------------
# Paddle (worldwide, merchant of record). Sandbox first: https://sandbox-vendors.paddle.com
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_ENV=sandbox

# PayHere (Sri Lanka). https://www.payhere.lk — sandbox merchant first.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_ENV=sandbox

# --- Email (activation links, receipts) ------------------------------------
EMAIL_PROVIDER=console               # console | resend
RESEND_API_KEY=
MAIL_FROM_NAME=Sillara
MAIL_FROM_EMAIL=hello@sillara.com

LOG_LEVEL=info

# --- Shelfie: photo → catalog (AI) ------------------------------------------
# Get a key at console.anthropic.com. Leave empty to hide the feature.
ANTHROPIC_API_KEY=
SHELFIE_MODEL=claude-opus-5

# --- Optional: demo seeding & integration testing ---------------------------
SEED_DEMO=false
TEST_DATABASE_URL=
